# Copy to .env and fill in. .env is git-ignored.

# Project Settings > API Keys (or the "Connect" button): Project URL, without trailing slash
SUPABASE_URL=https://your-project-ref.supabase.co

# Project Settings > API Keys > Publishable key (sb_publishable_...)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Authentication > OAuth Apps > your client (type: Confidential)
SUPABASE_OAUTH_CLIENT_ID=xxx
SUPABASE_OAUTH_CLIENT_SECRET=xxx
